#!/usr/bin/env bash
# Automatically converts any downloaded or saved non-PNG image into PNG format.

WATCH_DIRS=(
  "$(realpath "$HOME/Downloads" 2>/dev/null || echo "$HOME/Downloads")"
  "$(realpath "$HOME/Pictures" 2>/dev/null || echo "$HOME/Pictures")"
)

for d in "${WATCH_DIRS[@]}"; do
  mkdir -p "$d"
done

inotifywait -m -r -e close_write -e moved_to --format '%w%f' "${WATCH_DIRS[@]}" 2>/dev/null | while read -r filepath; do
  [[ -f "$filepath" ]] || continue

  # Match common non-PNG image extensions (case insensitive)
  case "${filepath,,}" in
    *.jpg|*.jpeg|*.webp|*.avif|*.jfif|*.bmp)
      # Skip temporary browser download files (.part, .crdownload, etc.)
      [[ "$filepath" == *.part* || "$filepath" == *.tmp* || "$filepath" == *.crdownload* ]] && continue
      
      # Small delay to ensure file lock is released
      sleep 0.2
      [[ -f "$filepath" ]] || continue

      target="${filepath%.*}.png"
      if magick "$filepath" "$target" 2>/dev/null; then
        rm -f "$filepath"
        echo "[auto-png] Converted $filepath -> $target"
        if command -v omarchy-notification-send >/dev/null 2>&1; then
          omarchy-notification-send "Image Converted to PNG" "${filepath##*/} ➔ $(basename "$target")" -t 2000 2>/dev/null || true
        fi
      fi
      ;;
  esac
done
