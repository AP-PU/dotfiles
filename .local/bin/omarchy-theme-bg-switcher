#!/bin/bash
theme_name=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
current_background=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)

image_dirs=()
[[ -d "$HOME/.local/state/omarchy/current/theme/backgrounds" ]] && image_dirs+=("$HOME/.local/state/omarchy/current/theme/backgrounds")
[[ -d "$HOME/.config/omarchy/backgrounds/$theme_name" ]] && image_dirs+=("$HOME/.config/omarchy/backgrounds/$theme_name")
[[ -d "$HOME/.config/omarchy/backgrounds" ]] && image_dirs+=("$HOME/.config/omarchy/backgrounds")
[[ -d "$HOME/Pictures/Wallpapers" ]] && image_dirs+=("$HOME/Pictures/Wallpapers")
[[ -d "$HOME/Pictures" ]] && image_dirs+=("$HOME/Pictures")

selected=$(omarchy-menu-images \
  --selected "$current_background" \
  "${image_dirs[@]}")

if [[ -n "$selected" && -f "$selected" ]]; then
  omarchy-theme-bg-set "$selected"
fi
