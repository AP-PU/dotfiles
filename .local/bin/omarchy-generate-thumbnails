#!/usr/bin/env python3
import os
import json
import hashlib
import subprocess
from concurrent.futures import ThreadPoolExecutor

THUMB_DIR = os.path.expanduser("~/.cache/omarchy/wallpaper_thumbs")
os.makedirs(THUMB_DIR, exist_ok=True)

def get_thumb_path(image_path):
    h = hashlib.sha1(image_path.encode()).hexdigest()
    return os.path.join(THUMB_DIR, f"{h}.jpg")

def create_thumb(image_path):
    thumb_path = get_thumb_path(image_path)
    if os.path.exists(thumb_path) and os.path.getsize(thumb_path) > 1024:
        return True
    try:
        cmd = [
            "magick",
            image_path,
            "-thumbnail", "280x160^",
            "-gravity", "center",
            "-extent", "280x160",
            "-quality", "85",
            thumb_path
        ]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
        return os.path.exists(thumb_path)
    except Exception as e:
        print(f"Error on {image_path}: {e}")
        return False

def main():
    import glob
    pattern = os.path.expanduser("~/Pictures/Wallpapers/*/*/*.*")
    files = glob.glob(pattern)
    valid_exts = {".png", ".jpg", ".jpeg", ".webp", ".avif"}
    images = [f for f in files if os.path.splitext(f)[1].lower() in valid_exts]
    
    # Also add ~/.config/omarchy/backgrounds
    bg_files = glob.glob(os.path.expanduser("~/.config/omarchy/backgrounds/*/*.*"))
    images.extend([f for f in bg_files if os.path.splitext(f)[1].lower() in valid_exts])
    
    images = list(set(images))
    print(f"Found {len(images)} images to process for thumbnails.")

    needed = [img for img in images if not os.path.exists(get_thumb_path(img))]
    print(f"{len(needed)} thumbnails need generation.")

    if needed:
        with ThreadPoolExecutor(max_workers=4) as executor:
            results = list(executor.map(create_thumb, needed))
        print(f"Generated {sum(1 for r in results if r)} new thumbnails.")
    else:
        print("All thumbnails are already cached!")

if __name__ == "__main__":
    main()
